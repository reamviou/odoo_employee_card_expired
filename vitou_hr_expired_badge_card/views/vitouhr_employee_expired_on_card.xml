<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- View for stock picking-->

    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">hr.employee.list</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="vitouhr_expired_date" optional="show"/>


            </xpath>
        </field>
    </record>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']//group[@name='identification_group']//div[@class='o_row']" position="after">

                <field name="vitouhr_expired_date" optional="show"/>
<!--                <page name="vitoucms" string="Casino Staffs">-->
<!--                    <group>                         -->
<!--                    </group>-->
<!--                </page>-->


            </xpath>
        </field>
    </record>
</odoo>
